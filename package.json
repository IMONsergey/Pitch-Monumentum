{
  "name": "pitch-monumentum",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI-native presentation development environment powered by PitchOS",
  "engines": {"node": ">=22"},
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:editor-spike": "esbuild apps/editor-spike/src/client.ts --bundle --format=iife --platform=browser --target=es2022 --outfile=apps/workspace/public/editor-spike.js",
    "build": "tsc -p tsconfig.build.json && npm run build:editor-spike",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "test:editor-e2e": "npm run build && node dist/tests/editor-spike.e2e.js",
    "check": "npm run typecheck && npm run test",
    "demo": "npm run build && node dist/apps/cli/src/index.js demo .pitch-demo",
    "status": "npm run build && node dist/apps/cli/src/index.js status .pitch-demo",
    "serve": "npm run build && node dist/apps/demo/src/server.js .pitch-demo 4173",
    "workspace": "npm run build && node dist/apps/workspace/src/server.js .pitch-demo 4173"
  },
  "dependencies": {
    "@scena/guides": "^0.29.2",
    "infinite-viewer": "^0.29.1",
    "moveable": "^0.53.0",
    "selecto": "^1.26.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "esbuild": "^0.25.0",
    "playwright": "^1.62.0",
    "typescript": "^5.8.3"
  }
}
