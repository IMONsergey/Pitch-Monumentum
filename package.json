{
  "name": "pitch-monumentum",
  "version": "0.3.0-preview.1",
  "private": true,
  "type": "module",
  "main": "dist/apps/desktop-full/src/main.js",
  "description": "AI-native presentation development environment powered by PitchOS",
  "engines": {"node": ">=22"},
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:editor-spike": "esbuild apps/editor-spike/src/bootstrap.ts --bundle --format=iife --platform=browser --target=es2022 --outfile=apps/workspace/public/editor-spike.js",
    "build": "tsc -p tsconfig.build.json && npm run build:editor-spike",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "test:editor-e2e": "npm run build && node --test --test-concurrency=1 dist/tests/*.e2e.js",
    "check": "npm run typecheck && npm run test",
    "release:preflight": "node scripts/release-preflight-full.mjs",
    "demo": "npm run build && node dist/apps/cli/src/index.js demo .pitch-demo",
    "status": "npm run build && node dist/apps/cli/src/index.js status .pitch-demo",
    "serve": "npm run build && node dist/apps/demo/src/server.js .pitch-demo 4173",
    "workspace": "npm run build && node dist/apps/workspace/src/full-server.js .pitch-demo 4173",
    "workspace:core": "npm run build && node dist/apps/workspace/src/server.js .pitch-demo 4173",
    "desktop": "npm run build && electron dist/apps/desktop-full/src/main.js",
    "desktop:core": "npm run build && electron dist/apps/desktop/src/main.js",
    "package:mac:x64": "node scripts/package-desktop-full.mjs",
    "package:mac:x64:core": "npm run build && electron-builder --config electron-builder.core.yml --mac dmg --x64 --publish never",
    "pitch:mcp": "npm run build && node dist/apps/pitch-mcp-full/src/server.js .pitch-demo",
    "pitch:mcp:core": "npm run build && node dist/apps/pitch-mcp/src/server.js .pitch-demo"
  },
  "dependencies": {
    "@lexical/history": "^0.48.0",
    "@lexical/list": "^0.48.0",
    "@lexical/rich-text": "^0.48.0",
    "@lexical/selection": "^0.48.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@scena/guides": "^0.29.2",
    "infinite-viewer": "^0.29.1",
    "lexical": "^0.48.0",
    "moveable": "^0.53.0",
    "perfect-freehand": "^1.2.2",
    "selecto": "^1.26.3",
    "yoga-layout": "^3.2.1",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "playwright": "^1.62.0",
    "typescript": "^5.8.3"
  }
}
