    {"repo":"facebook/lexical","role":"rich text editing runtime","priority":"P0","disposition":"integrate","license":"MIT"},
    {"repo":"react/yoga","role":"Figma-like constrained auto layout execution","priority":"P0","disposition":"integrate","license":"MIT"},
